rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // TROQUE os e-mails de exemplo pelos e-mails dos donos.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email.lower() in ["dono1@exemplo.com", "dono2@exemplo.com"] /* e-mails em minúsculas */;
    }

    // Dados públicos do catálogo.
    match /stock/{item} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Dados internos (IMEI, custo, preço, vendas): só os donos leem e escrevem.
    match /stock_private/{item} {
      allow read, write: if isOwner();
    }
  }
}
